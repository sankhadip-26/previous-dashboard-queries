function DAILYBU() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const SOURCE_SHEET = "DAILY SUBCAT";
  const OUTPUT_SHEET = "DAILY BU";

  const source = ss.getSheetByName(SOURCE_SHEET);

  if (!source) {
    throw new Error("Source sheet '" + SOURCE_SHEET + "' not found.");
  }

  let output = ss.getSheetByName(OUTPUT_SHEET);

  if (!output) {
    output = ss.insertSheet(OUTPUT_SHEET);
  }

  // =====================================================
  // READ SOURCE
  // =====================================================

  const sourceData = source.getDataRange().getValues();

  if (sourceData.length < 3) {
    output.clear();
    return;
  }

  const headers = sourceData[1];

  const buIndex = headers.indexOf("MASTER BU");
  const subcatIndex = headers.indexOf("SUBCAT");

  if (buIndex === -1 || subcatIndex === -1) {
    throw new Error(
      "Required columns MASTER BU or SUBCAT not found in SUBCAT DAILY."
    );
  }

  // =====================================================
  // GET DATE COLUMNS
  // =====================================================

  const totalSourceColumns = source.getLastColumn();

  // Source:
  // A = MASTER BU
  // B = SUBCAT
  // C onwards = dates / totals

  const sourceHeadersRow2 = sourceData[1];

  // =====================================================
  // FIND SUBTOTAL ROWS
  // =====================================================

  const subtotalRows = [];

  for (let i = 2; i < sourceData.length; i++) {

    const row = sourceData[i];

    if (String(row[subcatIndex]).trim().toUpperCase() === "SUBTOTAL") {
      subtotalRows.push(row);
    }
  }

  // =====================================================
  // CLEAR OUTPUT
  // =====================================================

  output.clear();

  const maxRows = Math.max(output.getMaxRows(), 2);
  const maxColumns = Math.max(output.getMaxColumns(), 2);

  output
    .getRange(1, 1, maxRows, maxColumns)
    .breakApart();

  // =====================================================
  // NEW COLUMN STRUCTURE
  // =====================================================

  // Remove source column B = SUBCAT
  //
  // Keep:
  // A = MASTER BU
  // C onwards = all other columns

  const outputColumnIndexes = [];

  for (let col = 0; col < totalSourceColumns; col++) {

    if (col !== subcatIndex) {
      outputColumnIndexes.push(col);
    }
  }

  const totalColumns = outputColumnIndexes.length;

  // =====================================================
  // REQUIRED ROWS
  // =====================================================

  const totalRows = 3 + subtotalRows.length;

  // =====================================================
  // AUTO EXPAND OUTPUT
  // =====================================================

  if (output.getMaxRows() < totalRows) {

    output.insertRowsAfter(
      output.getMaxRows(),
      totalRows - output.getMaxRows()
    );
  }

  if (output.getMaxColumns() < totalColumns) {

    output.insertColumnsAfter(
      output.getMaxColumns(),
      totalColumns - output.getMaxColumns()
    );
  }

  // =====================================================
  // ROW 1
  // =====================================================

  // Copy Row 1 values from source except SUBCAT column
  const row1Values = [];

  outputColumnIndexes.forEach(function (index) {
    row1Values.push(sourceData[0][index]);
  });

  output
    .getRange(1, 1, 1, totalColumns)
    .setValues([row1Values]);

  // =====================================================
  // ROW 2
  // =====================================================

  const row2Values = [];

  outputColumnIndexes.forEach(function (index) {
    row2Values.push(sourceData[1][index]);
  });

  output
    .getRange(2, 1, 1, totalColumns)
    .setValues([row2Values]);

  // =====================================================
  // DATA - ONLY SUBTOTAL ROWS
  // =====================================================

  const outputData = [];

  subtotalRows.forEach(function (sourceRow) {

    const newRow = [];

    outputColumnIndexes.forEach(function (index) {
      newRow.push(sourceRow[index]);
    });

    outputData.push(newRow);
  });

  if (outputData.length > 0) {

    output
      .getRange(
        3,
        1,
        outputData.length,
        totalColumns
      )
      .setValues(outputData);
  }
// =====================================================
// PLATFORM TOTAL ROW
// =====================================================

const platformRow = 3 + subtotalRows.length;

const platformOutput = ["PLATFORM"];


// Sum each column from all BU subtotal rows
for (let col = 1; col < outputColumnIndexes.length; col++) {

  let total = 0;

  subtotalRows.forEach(function (sourceRow) {

    const value = Number(
      sourceRow[outputColumnIndexes[col]]
    ) || 0;

    total += value;
  });

  platformOutput.push(total);
}

output
  .getRange(
    platformRow,
    1,
    1,
    totalColumns
  )
  .setValues([platformOutput]);

  // =====================================================
  // MERGE DATE HEADERS
  // =====================================================

  // In source, dates start from column C.
  // After removing column B, dates start from column B.

  // Each date occupies 2 columns: QTY + GMV

  const dateColumnCount = totalColumns - 3;

  // Because:
  // A = MASTER BU
  // B onwards = date columns
  // Last 2 = TOTAL QTY / TOTAL GMV

  const numberOfDateColumns = totalColumns - 3;

  for (
    let startColumn = 2;
    startColumn <= numberOfDateColumns;
    startColumn += 2
  ) {

    output
      .getRange(1, startColumn, 1, 2)
      .merge();

    output
      .getRange(1, startColumn)
      .setHorizontalAlignment("center")
      .setVerticalAlignment("middle")
      .setFontWeight("bold");
  }

  // =====================================================
  // BASIC FORMATTING
  // =====================================================

  output
    .getRange(
      1,
      1,
      totalRows,
      totalColumns
    )
    .setFontFamily("Calibri")
    .setFontSize(10)
    .setVerticalAlignment("middle");

  // =====================================================
  // HEADER FORMATTING
  // =====================================================

  output
    .getRange(
      1,
      1,
      2,
      totalColumns
    )
    .setFontWeight("bold");

  output
    .getRange(
      1,
      1,
      2,
      totalColumns
    )
    .setBackground("#F3F3F3");

  output
    .getRange(
      1,
      1,
      2,
      totalColumns
    )
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");

  // =====================================================
  // DATA FORMATTING
  // =====================================================

  if (totalRows > 2) {

    output
      .getRange(
        3,
        1,
        totalRows - 2,
        1
      )
      .setHorizontalAlignment("left")
      .setFontWeight("bold");

    output
      .getRange(
        3,
        2,
        totalRows - 2,
        totalColumns - 1
      )
      .setHorizontalAlignment("right");
  }

  // =====================================================
  // NUMBER FORMATTING
  // =====================================================

  // Date QTY / GMV columns
  for (
    let col = 2;
    col <= numberOfDateColumns;
    col += 2
  ) {

    output
      .getRange(
        3,
        col,
        Math.max(totalRows - 2, 1),
        1
      )
      .setNumberFormat("#,##0");

    output
      .getRange(
        3,
        col + 1,
        Math.max(totalRows - 2, 1),
        1
      )
      .setNumberFormat("#,##0.00");
  }

  // TOTAL QTY
  const totalQtyColumn = totalColumns - 1;

  // TOTAL GMV
  const totalGmvColumn = totalColumns;

  output
    .getRange(
      3,
      totalQtyColumn,
      Math.max(totalRows - 2, 1),
      1
    )
    .setNumberFormat("#,##0")
    .setFontWeight("bold");

  output
    .getRange(
      3,
      totalGmvColumn,
      Math.max(totalRows - 2, 1),
      1
    )
    .setNumberFormat("#,##0.00")
    .setFontWeight("bold");

  // =====================================================
  // COLUMN WIDTHS
  // =====================================================

  output.setColumnWidth(1, 130);

  for (
    let col = 2;
    col <= numberOfDateColumns;
    col += 2
  ) {

    output.setColumnWidth(col, 75);
    output.setColumnWidth(col + 1, 85);
  }

  output.setColumnWidth(totalQtyColumn, 95);
  output.setColumnWidth(totalGmvColumn, 105);

  // =====================================================
  // ROW HEIGHTS
  // =====================================================

  output.setRowHeight(1, 28);
  output.setRowHeight(2, 28);

  if (totalRows > 2) {
    output.setRowHeights(
      3,
      totalRows - 2,
      24
    );
  }

  // =====================================================
  // CLEAN BORDERS
  // =====================================================

  output
    .getRange(
      1,
      1,
      totalRows,
      totalColumns
    )
    .setBorder(
      false,
      false,
      false,
      false,
      false,
      false
    );

  // Bottom border under Row 2
  output
    .getRange(
      2,
      1,
      1,
      totalColumns
    )
    .setBorder(
      null,
      null,
      true,
      null,
      null,
      null
    );

  // Separator after MASTER BU
  output
    .getRange(
      1,
      1,
      totalRows,
      1
    )
    .setBorder(
      null,
      null,
      null,
      true,
      null,
      null
    );

  // Separator after every GMV
  for (
    let col = 3;
    col <= numberOfDateColumns;
    col += 2
  ) {

    output
      .getRange(
        1,
        col,
        totalRows,
        1
      )
      .setBorder(
        null,
        null,
        null,
        true,
        null,
        null
      );
  }

  // Separator before TOTAL section
  output
    .getRange(
      1,
      totalQtyColumn,
      totalRows,
      1
    )
    .setBorder(
      null,
      true,
      null,
      null,
      null,
      null
    );

  // =====================================================
  // BU COLOUR SHADING
  // =====================================================

  const buColors = [
    "#EAF2F8",
    "#FCE4EC",
    "#E8F5E9",
    "#FFF3E0",
    "#F3E5F5",
    "#E0F7FA",
    "#FFFDE7",
    "#ECEFF1",
    "#FBE9E7",
    "#E8EAF6"
  ];

  for (let i = 0; i < subtotalRows.length; i++) {

    const color =
      buColors[i % buColors.length];

    output
      .getRange(
        3 + i,
        1,
        1,
        totalColumns
      )
      .setBackground(color)
      .setFontWeight("bold");
  }
// =====================================================
// PLATFORM ROW HIGHLIGHT
// =====================================================

output
  .getRange(
    platformRow,
    1,
    1,
    totalColumns
  )
  .setBackground("#D9EAD3")
  .setFontWeight("bold")
  .setBorder(
    true,
    null,
    true,
    null,
    null,
    null
  );
  // =====================================================
  // TOTAL COLUMNS
  // =====================================================

  output
    .getRange(
      1,
      totalQtyColumn,
      totalRows,
      2
    )
    .setFontWeight("bold");

  // =====================================================
  // FREEZE
  // =====================================================

  output.setFrozenRows(2);
  output.setFrozenColumns(1);

  // =====================================================
  // REMOVE OLD FILTER
  // =====================================================

  if (output.getFilter()) {
    output.getFilter().remove();
  }

  // =====================================================
  // CREATE FILTER
  // =====================================================

  if (totalRows > 2) {

    output
      .getRange(
        2,
        1,
        totalRows - 1,
        totalColumns
      )
      .createFilter();
  }

  // =====================================================
  // FINAL
  // =====================================================

  SpreadsheetApp.flush();
}

