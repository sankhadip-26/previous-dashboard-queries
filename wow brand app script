function BRANDWOW(){
  const SOURCE_SHEET = "BRAND QUERY";
  const OUTPUT_SHEET = "BRAND WOW";

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const source = ss.getSheetByName(SOURCE_SHEET);
  let output = ss.getSheetByName(OUTPUT_SHEET);

  if (!source) throw new Error("Source sheet not found: " + SOURCE_SHEET);
  if (!output) output = ss.insertSheet(OUTPUT_SHEET);

  if (output.getFilter()) output.getFilter().remove();
  output.clear();

  const data = source.getDataRange().getValues();
  if (data.length < 2) return;

  const headers = data[0];

  const dateCol = headers.indexOf("DATE");
  const buCol = headers.indexOf("MASTER BU");
  const brandCol = headers.indexOf("BRAND");
  const qtyCol = headers.indexOf("QTY");
  const gmvCol = headers.indexOf("GMV");
  const rowTypeCol = headers.indexOf("ROW_TYPE");

  if (
    dateCol === -1 ||
    buCol === -1 ||
    brandCol === -1 ||
    qtyCol === -1 ||
    gmvCol === -1 ||
    rowTypeCol === -1
  ) {
    throw new Error(
      "Required columns are missing in BRAND QUERY. Required: DATE, MASTER BU, BRAND, QTY, GMV, ROW_TYPE."
    );
  }

  // ---------------------------------------------------------
  // GET DATES
  // ---------------------------------------------------------

  const dates = [];

  for (let i = 1; i < data.length; i++) {
    const rawDate = data[i][dateCol];
    if (!rawDate) continue;

    const date = new Date(rawDate);

    if (!isNaN(date.getTime())) {
      date.setHours(0, 0, 0, 0);
      dates.push(date);
    }
  }

  if (dates.length === 0) return;

  dates.sort((a, b) => a - b);

  const firstDate = dates[0];
  const year = firstDate.getFullYear();
  const month = firstDate.getMonth();

  // ---------------------------------------------------------
  // MONDAY-SUNDAY WEEK HELPERS
  // ---------------------------------------------------------

  function getMonday(date) {
    const d = new Date(date);
    d.setHours(0, 0, 0, 0);

    const day = d.getDay();

    // Monday = 1
    // Sunday = 0
    const difference =
      day === 0
        ? -6
        : 1 - day;

    d.setDate(
      d.getDate() + difference
    );

    return d;
  }

  function addDays(date, days) {
    const d = new Date(date);

    d.setDate(
      d.getDate() + days
    );

    return d;
  }

  function ordinal(day) {

    if (day >= 11 && day <= 13) {
      return day + "th";
    }

    switch (day % 10) {

      case 1:
        return day + "st";

      case 2:
        return day + "nd";

      case 3:
        return day + "rd";

      default:
        return day + "th";
    }
  }

  // ---------------------------------------------------------
  // WEEK BUCKETS
  //
  // Monday - Sunday
  //
  // Includes the Monday-Sunday week BEFORE the week
  // containing the 1st of the month, so first month
  // week has a WoW comparison.
  // ---------------------------------------------------------

  const weekBuckets = {};

  // Monday of the week containing the 1st
  const firstMonthMonday =
    getMonday(
      new Date(year, month, 1)
    );

  // One complete week before it
  const reportStart =
    addDays(
      firstMonthMonday,
      -7
    );

  // Current week's Monday
  const today = new Date();

  const currentWeekMonday =
    getMonday(today);

  let currentMonday =
    new Date(reportStart);

  let weekNumber = 1;

  while (
    currentMonday <= currentWeekMonday
  ) {

    const weekEnd =
      addDays(
        currentMonday,
        6
      );

    weekEnd.setHours(
      23,
      59,
      59,
      999
    );

    weekBuckets[weekNumber] = {
      start: new Date(currentMonday),
      end: new Date(weekEnd)
    };

    currentMonday =
      addDays(
        currentMonday,
        7
      );

    weekNumber++;
  }

  // ---------------------------------------------------------
  // AVAILABLE WEEKS
  // ---------------------------------------------------------

  const availableWeekNumbers = [];

  Object.keys(weekBuckets).forEach(
    weekNumber => {

      const bucket =
        weekBuckets[weekNumber];

      const hasData =
        dates.some(date =>
          date >= bucket.start &&
          date <= bucket.end
        );

      if (hasData) {
        availableWeekNumbers.push(
          Number(weekNumber)
        );
      }
    }
  );

  availableWeekNumbers.sort(
    (a, b) => a - b
  );

  const columnsPerWeek = 4;

  const totalColumns =
    2 +
    availableWeekNumbers.length *
    columnsPerWeek;

  // ---------------------------------------------------------
  // HEADERS
  // ---------------------------------------------------------

  const headerRow1 = ["", ""];
  const headerRow2 = [
    "MASTER BU",
    "BRAND"
  ];

  availableWeekNumbers.forEach(
    weekNumber => {

      const bucket =
        weekBuckets[weekNumber];

      const startMonth =
        Utilities.formatDate(
          bucket.start,
          Session.getScriptTimeZone(),
          "MMM"
        );

      const endMonth =
        Utilities.formatDate(
          bucket.end,
          Session.getScriptTimeZone(),
          "MMM"
        );

      let weekLabel;

      if (
        bucket.start.getMonth() ===
        bucket.end.getMonth()
      ) {

        weekLabel =
          ordinal(
            bucket.start.getDate()
          ) +
          " to " +
          ordinal(
            bucket.end.getDate()
          ) +
          " " +
          endMonth;

      } else {

        weekLabel =
          ordinal(
            bucket.start.getDate()
          ) +
          " " +
          startMonth +
          " to " +
          ordinal(
            bucket.end.getDate()
          ) +
          " " +
          endMonth;
      }

      headerRow1.push(
        weekLabel,
        "",
        "",
        ""
      );

      headerRow2.push(
        "QTY",
        "GMV",
        "QTY WoW %",
        "GMV WoW %"
      );
    }
  );

  // ---------------------------------------------------------
  // DATA COLLECTION
  // ---------------------------------------------------------

  const brandData = {};
  const subtotalData = {};

  for (let i = 1; i < data.length; i++) {

    const row = data[i];

    const rawDate = row[dateCol];

    if (!rawDate) continue;

    const date =
      new Date(rawDate);

    if (isNaN(date.getTime())) continue;

    date.setHours(
      0,
      0,
      0,
      0
    );

    /*
     * Only process the original month.
     *
     * The extra previous week is used for
     * comparison only when it contains dates
     * belonging to the previous month.
     *
     * Therefore we need to allow the previous
     * week data also.
     */

    const dayNumber =
      date.getDate();

    const dateYear =
      date.getFullYear();

    const dateMonth =
      date.getMonth();

    // Find which Monday-Sunday bucket this date belongs to
    let matchingWeekNumber = null;

    Object.keys(weekBuckets).forEach(
      weekNum => {

        const bucket =
          weekBuckets[weekNum];

        if (
          date >= bucket.start &&
          date <= bucket.end
        ) {
          matchingWeekNumber =
            Number(weekNum);
        }
      }
    );

    if (
      matchingWeekNumber === null
    ) {
      continue;
    }

    /*
     * Only use:
     * - previous comparison week
     * - current month weeks
     *
     * Do not pull unrelated old data.
     */

    const firstMonthWeek =
      weekBuckets[1];

    if (
      matchingWeekNumber === 1
    ) {

      // Always allow the comparison week
      // because it may contain previous-month dates.

    } else {

      // Continue normally.
    }

    const bu = row[buCol];
    const brand = row[brandCol];
    const rowType = row[rowTypeCol];

    const qty =
      Number(row[qtyCol]) || 0;

    const gmv =
      Number(row[gmvCol]) || 0;

    // -------------------------------------------------------
    // BRAND ROWS
    // -------------------------------------------------------

    if (rowType === "BRAND") {

      const key =
        bu +
        "||" +
        brand;

      if (!brandData[key]) {

        brandData[key] = {
          bu: bu,
          brand: brand,
          weeks: {}
        };
      }

      if (
        !brandData[key].weeks[
          matchingWeekNumber
        ]
      ) {

        brandData[key].weeks[
          matchingWeekNumber
        ] = {
          qty: 0,
          gmv: 0
        };
      }

      brandData[key]
        .weeks[matchingWeekNumber]
        .qty += qty;

      brandData[key]
        .weeks[matchingWeekNumber]
        .gmv += gmv;
    }

    // -------------------------------------------------------
    // BU SUBTOTAL ROWS
    // -------------------------------------------------------

    if (
      rowType === "BU_SUBTOTAL"
    ) {

      if (!subtotalData[bu]) {

        subtotalData[bu] = {
          bu: bu,
          weeks: {}
        };
      }

      if (
        !subtotalData[bu].weeks[
          matchingWeekNumber
        ]
      ) {

        subtotalData[bu].weeks[
          matchingWeekNumber
        ] = {
          qty: 0,
          gmv: 0
        };
      }

      subtotalData[bu]
        .weeks[matchingWeekNumber]
        .qty += qty;

      subtotalData[bu]
        .weeks[matchingWeekNumber]
        .gmv += gmv;
    }
  }

  // ---------------------------------------------------------
  // GROUP BRAND BY BU
  // ---------------------------------------------------------

  const buGroups = {};

  Object.keys(brandData).forEach(
    key => {

      const item =
        brandData[key];

      if (!buGroups[item.bu]) {
        buGroups[item.bu] = [];
      }

      buGroups[item.bu].push(item);
    }
  );

  const bus =
    Object.keys(buGroups).sort();

  bus.forEach(
    bu => {

      buGroups[bu].sort(
        (a, b) =>
          String(a.brand)
            .localeCompare(
              String(b.brand)
            )
      );
    }
  );

  // ---------------------------------------------------------
  // OUTPUT DATA
  // ---------------------------------------------------------

  const outputData = [];

  outputData.push(
    headerRow1
  );

  outputData.push(
    headerRow2
  );

  const subtotalRows = [];

  // ---------------------------------------------------------
  // PLATFORM TOTALS
  // ---------------------------------------------------------

  const platformWeeks = {};

  availableWeekNumbers.forEach(
    weekNumber => {

      platformWeeks[weekNumber] = {
        qty: 0,
        gmv: 0
      };
    }
  );

  // ---------------------------------------------------------
  // BU + BRAND ROWS
  // ---------------------------------------------------------

  bus.forEach(
    bu => {

      const items =
        buGroups[bu];

      items.forEach(
        item => {

          const outputRow = [
            item.bu,
            item.brand
          ];

          availableWeekNumbers.forEach(
            weekNumber => {

              const current =
                item.weeks[
                  weekNumber
                ] || {
                  qty: 0,
                  gmv: 0
                };

              const currentIndex =
                availableWeekNumbers.indexOf(
                  weekNumber
                );

              const previousWeekNumber =
                availableWeekNumbers[
                  currentIndex - 1
                ];

              let previousQty = 0;
              let previousGmv = 0;

              if (
                previousWeekNumber !==
                  undefined &&
                item.weeks[
                  previousWeekNumber
                ]
              ) {

                previousQty =
                  item.weeks[
                    previousWeekNumber
                  ].qty;

                previousGmv =
                  item.weeks[
                    previousWeekNumber
                  ].gmv;
              }

              const qtyWow =
                previousQty === 0
                  ? ""
                  :
                    (
                      current.qty -
                      previousQty
                    ) /
                    previousQty;

              const gmvWow =
                previousGmv === 0
                  ? ""
                  :
                    (
                      current.gmv -
                      previousGmv
                    ) /
                    previousGmv;

              outputRow.push(
                current.qty,
                current.gmv,
                qtyWow,
                gmvWow
              );
            }
          );

          outputData.push(
            outputRow
          );
        }
      );

      // -------------------------------------------------------
      // BU SUBTOTAL
      // -------------------------------------------------------

      const subtotalRow = [
        bu,
        "SUBTOTAL"
      ];

      availableWeekNumbers.forEach(
        weekNumber => {

          const current =
            subtotalData[bu] &&
            subtotalData[bu].weeks[
              weekNumber
            ]
              ? subtotalData[bu].weeks[
                  weekNumber
                ]
              : {
                  qty: 0,
                  gmv: 0
                };

          const currentIndex =
            availableWeekNumbers.indexOf(
              weekNumber
            );

          const previousWeekNumber =
            availableWeekNumbers[
              currentIndex - 1
            ];

          let previousQty = 0;
          let previousGmv = 0;

          if (
            previousWeekNumber !==
              undefined &&
            subtotalData[bu] &&
            subtotalData[bu].weeks[
              previousWeekNumber
            ]
          ) {

            previousQty =
              subtotalData[bu]
                .weeks[
                  previousWeekNumber
                ].qty;

            previousGmv =
              subtotalData[bu]
                .weeks[
                  previousWeekNumber
                ].gmv;
          }

          const qtyWow =
            previousQty === 0
              ? ""
              :
                (
                  current.qty -
                  previousQty
                ) /
                previousQty;

          const gmvWow =
            previousGmv === 0
              ? ""
              :
                (
                  current.gmv -
                  previousGmv
                ) /
                previousGmv;

          subtotalRow.push(
            current.qty,
            current.gmv,
            qtyWow,
            gmvWow
          );

          platformWeeks[
            weekNumber
          ].qty += current.qty;

          platformWeeks[
            weekNumber
          ].gmv += current.gmv;
        }
      );

      subtotalRows.push(
        outputData.length + 1
      );

      outputData.push(
        subtotalRow
      );
    }
  );

  // ---------------------------------------------------------
  // PLATFORM TOTAL
  // ---------------------------------------------------------

  const platformRow = [
    "PLATFORM",
    ""
  ];

  availableWeekNumbers.forEach(
    weekNumber => {

      const current =
        platformWeeks[
          weekNumber
        ];

      const currentIndex =
        availableWeekNumbers.indexOf(
          weekNumber
        );

      const previousWeekNumber =
        availableWeekNumbers[
          currentIndex - 1
        ];

      let previousQty = 0;
      let previousGmv = 0;

      if (
        previousWeekNumber !==
          undefined &&
        platformWeeks[
          previousWeekNumber
        ]
      ) {

        previousQty =
          platformWeeks[
            previousWeekNumber
          ].qty;

        previousGmv =
          platformWeeks[
            previousWeekNumber
          ].gmv;
      }

      const qtyWow =
        previousQty === 0
          ? ""
          :
            (
              current.qty -
              previousQty
            ) /
            previousQty;

      const gmvWow =
        previousGmv === 0
          ? ""
          :
            (
              current.gmv -
              previousGmv
            ) /
            previousGmv;

      platformRow.push(
        current.qty,
        current.gmv,
        qtyWow,
        gmvWow
      );
    }
  );

  outputData.push(
    platformRow
  );

  // ---------------------------------------------------------
  // WRITE DATA
  // ---------------------------------------------------------

  output
    .getRange(
      1,
      1,
      outputData.length,
      totalColumns
    )
    .setValues(
      outputData
    );

  // ---------------------------------------------------------
  // CALIBRI FONT
  // ---------------------------------------------------------

  output
    .getRange(
      1,
      1,
      Math.max(
        output.getMaxRows(),
        outputData.length + 2
      ),
      totalColumns
    )
    .setFontFamily(
      "Calibri"
    );

  // ---------------------------------------------------------
  // HEADER BASIC FORMATTING
  // ---------------------------------------------------------

  output
    .getRange(
      1,
      1,
      1,
      totalColumns
    )
    .setFontWeight("bold")
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");

  output
    .getRange(
      2,
      1,
      1,
      totalColumns
    )
    .setFontWeight("bold")
    .setHorizontalAlignment("center")
    .setVerticalAlignment("middle");

  output
    .getRange(
      2,
      1,
      1,
      2
    )
    .setBackground(
      "#D9EAF7"
    )
    .setFontColor(
      "#000000"
    );

  // ---------------------------------------------------------
  // WEEK HEADER COLORS
  // ---------------------------------------------------------

  const weekHeaderColors = [
    "#4472C4",
    "#548235",
    "#C55A11",
    "#7030A0",
    "#008C95",
    "#5B5B5B"
  ];

  availableWeekNumbers.forEach(
    (weekNumber, index) => {

      const startColumn =
        3 +
        index *
        columnsPerWeek;

      output
        .getRange(
          1,
          startColumn,
          1,
          columnsPerWeek
        )
        .merge();

      output
        .getRange(
          1,
          startColumn,
          1,
          columnsPerWeek
        )
        .setBackground(
          weekHeaderColors[
            index %
            weekHeaderColors.length
          ]
        )
        .setFontColor(
          "#FFFFFF"
        )
        .setFontWeight(
          "bold"
        )
        .setHorizontalAlignment(
          "center"
        )
        .setVerticalAlignment(
          "middle"
        );

      output
        .getRange(
          2,
          startColumn,
          1,
          columnsPerWeek
        )
        .setBackground(
          "#D9EAF7"
        )
        .setFontColor(
          "#000000"
        )
        .setFontWeight(
          "bold"
        )
        .setHorizontalAlignment(
          "center"
        )
        .setVerticalAlignment(
          "middle"
        );
    }
  );

  // ---------------------------------------------------------
  // HEADER + BUCKET BORDERS
  // ---------------------------------------------------------

  output
    .getRange(
      1,
      1,
      2,
      totalColumns
    )
    .setBorder(
      true,
      true,
      true,
      true,
      true,
      true,
      "#808080",
      SpreadsheetApp.BorderStyle.SOLID
    );

  availableWeekNumbers.forEach(
    (weekNumber, index) => {

      const startColumn =
        3 +
        index *
        columnsPerWeek;

      output
        .getRange(
          1,
          startColumn,
          outputData.length,
          columnsPerWeek
        )
        .setBorder(
          true,
          true,
          true,
          true,
          true,
          true,
          "#B7B7B7",
          SpreadsheetApp.BorderStyle.SOLID
        );

      output
        .getRange(
          1,
          startColumn,
          outputData.length,
          1
        )
        .setBorder(
          null,
          true,
          null,
          null,
          null,
          null,
          "#666666",
          SpreadsheetApp.BorderStyle.SOLID_MEDIUM
        );

      output
        .getRange(
          1,
          startColumn +
            columnsPerWeek -
            1,
          outputData.length,
          1
        )
        .setBorder(
          null,
          null,
          null,
          true,
          null,
          null,
          "#666666",
          SpreadsheetApp.BorderStyle.SOLID_MEDIUM
        );
    }
  );

  // ---------------------------------------------------------
  // STRONG SEPARATOR AFTER BRAND
  // ---------------------------------------------------------

  output
    .getRange(
      1,
      2,
      outputData.length,
      1
    )
    .setBorder(
      null,
      null,
      null,
      true,
      null,
      null,
      "#666666",
      SpreadsheetApp.BorderStyle.SOLID_MEDIUM
    );

  // ---------------------------------------------------------
  // BU COLORS
  // ---------------------------------------------------------

  const buColors = [
    "#DDEBF7",
    "#FFF2CC",
    "#FCE4D6",
    "#E4DFEC",
    "#D9EAF7",
    "#FCE4D6",
    "#F4CCCC",
    "#EADCF8",
    "#F9E2D2",
    "#DDE2F3"
  ];

  let dataRowNumber = 3;

  bus.forEach(
    (bu, buIndex) => {

      const brandCount =
        buGroups[bu].length;

      if (brandCount > 0) {

        output
          .getRange(
            dataRowNumber,
            1,
            brandCount,
            totalColumns
          )
          .setBackground(
            buColors[
              buIndex %
              buColors.length
            ]
          );
      }

      dataRowNumber +=
        brandCount + 1;
    }
  );

  // ---------------------------------------------------------
  // SUBTOTAL FORMATTING
  // ---------------------------------------------------------

  subtotalRows.forEach(
    rowNumber => {

      output
        .getRange(
          rowNumber,
          1,
          1,
          totalColumns
        )
        .setBackground(
          "#D9EAD3"
        )
        .setFontWeight(
          "bold"
        )
        .setBorder(
          true,
          null,
          true,
          null,
          null,
          null
        );
    }
  );

  // ---------------------------------------------------------
  // PLATFORM FORMATTING
  // ---------------------------------------------------------

  const platformRowNumber =
    outputData.length;

  output
    .getRange(
      platformRowNumber,
      1,
      1,
      totalColumns
    )
    .setBackground(
      "#CFE2F3"
    )
    .setFontWeight(
      "bold"
    )
    .setBorder(
      true,
      null,
      true,
      null,
      null,
      null
    );

  // ---------------------------------------------------------
  // NUMBER FORMATTING
  // ---------------------------------------------------------

  availableWeekNumbers.forEach(
    (weekNumber, index) => {

      const startColumn =
        3 +
        index *
        columnsPerWeek;

      output
        .getRange(
          3,
          startColumn,
          outputData.length - 2,
          1
        )
        .setNumberFormat(
          "#,##0"
        );

      output
        .getRange(
          3,
          startColumn + 1,
          outputData.length - 2,
          1
        )
        .setNumberFormat(
          "#,##0.00"
        );

      output
        .getRange(
          3,
          startColumn + 2,
          outputData.length - 2,
          1
        )
        .setNumberFormat(
          "0.0%"
        );

      output
        .getRange(
          3,
          startColumn + 3,
          outputData.length - 2,
          1
        )
        .setNumberFormat(
          "0.0%"
        );
    }
  );

  // ---------------------------------------------------------
  // CONDITIONAL FORMATTING
  // ---------------------------------------------------------

  const growthRanges = [];

  availableWeekNumbers.forEach(
    (weekNumber, index) => {

      const startColumn =
        3 +
        index *
        columnsPerWeek;

      growthRanges.push(
        output.getRange(
          3,
          startColumn + 2,
          outputData.length - 2,
          2
        )
      );
    }
  );

  const conditionalRules = [];

  growthRanges.forEach(
    range => {

      conditionalRules.push(

        SpreadsheetApp
          .newConditionalFormatRule()
          .whenNumberLessThan(0)
          .setBackground(
            "#F4CCCC"
          )
          .setFontColor(
            "#9C0006"
          )
          .setRanges([range])
          .build(),

        SpreadsheetApp
          .newConditionalFormatRule()
          .whenNumberBetween(
            0,
            0.10
          )
          .setBackground(
            "#FFF2CC"
          )
          .setFontColor(
            "#9C6500"
          )
          .setRanges([range])
          .build(),

        SpreadsheetApp
          .newConditionalFormatRule()
          .whenNumberGreaterThan(
            0.10
          )
          .setBackground(
            "#D9EAD3"
          )
          .setFontColor(
            "#006100"
          )
          .setRanges([range])
          .build()
      );
    }
  );

  output.setConditionalFormatRules(
    conditionalRules
  );

  // ---------------------------------------------------------
  // ALIGNMENT
  // ---------------------------------------------------------

  output
    .getRange(
      3,
      3,
      Math.max(
        outputData.length - 2,
        1
      ),
      totalColumns - 2
    )
    .setHorizontalAlignment(
      "center"
    );

  output
    .getRange(
      3,
      1,
      Math.max(
        outputData.length - 2,
        1
      ),
      2
    )
    .setHorizontalAlignment(
      "left"
    );

  // ---------------------------------------------------------
  // FREEZE
  // ---------------------------------------------------------

  output.setFrozenRows(2);
  output.setFrozenColumns(2);

  // ---------------------------------------------------------
  // COLUMN WIDTHS
  // ---------------------------------------------------------

  output.setColumnWidth(
    1,
    150
  );

  output.setColumnWidth(
    2,
    190
  );

  availableWeekNumbers.forEach(
    (weekNumber, index) => {

      const startColumn =
        3 +
        index *
        columnsPerWeek;

      output.setColumnWidth(
        startColumn,
        85
      );

      output.setColumnWidth(
        startColumn + 1,
        90
      );

      output.setColumnWidth(
        startColumn + 2,
        105
      );

      output.setColumnWidth(
        startColumn + 3,
        110
      );
    }
  );

  // ---------------------------------------------------------
  // ROW HEIGHTS
  // ---------------------------------------------------------

  output.setRowHeight(
    1,
    30
  );

  output.setRowHeight(
    2,
    25
  );

  // ---------------------------------------------------------
  // FILTER
  // ---------------------------------------------------------

  if (
    outputData.length > 2
  ) {

    output
      .getRange(
        2,
        1,
        outputData.length - 1,
        totalColumns
      )
      .createFilter();
  }
}
